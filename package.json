{
  "name": "demoframe",
  "version": "1.0.0",
  "description": "A desktop application for recording short product demos and tutorials",
  "main": "./out/main/index.js",
  "author": "Juan Albarrán <jalbarrandev@gmail.com>",
  "homepage": "https://github.com/jalbarrang/demoframe",
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "pnpm run typecheck:node && pnpm run svelte-check",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:tag": "node scripts/release-tag.mjs",
    "release": "pnpm run typecheck && electron-builder --publish always"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "bits-ui": "^2.16.5",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.3.0",
    "svelte-spa-router": "^5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.19.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "oxfmt": "0.43.0",
    "oxlint": "1.58.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^7.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
